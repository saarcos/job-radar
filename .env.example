# Copy to .env and adjust: cp .env.example .env
# .env is read by Docker Compose and by the app when it runs from the host.

# db service. Only applied when the Postgres volume is first created.
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=local
POSTGRES_DB=jobradar

# Connection string for running from the host (uv run ...).
# docker-compose.yml overrides it inside the api container to point at db:5432.
# 127.0.0.1, not localhost: on Windows, localhost tries ::1 first, where compose
# publishes nothing, and psycopg waits the whole connect timeout (3 s) there
# before trying 127.0.0.1. That is 3 s on every connection.
DATABASE_URL=postgresql+psycopg://jobradar:local@127.0.0.1:5433/jobradar

# Throwaway database for tests/integration, on the same server. The tests drop
# and recreate it (and <name>_models_test) on every run, so its name must end
# in _test. Never point it at a database you want to keep.
TEST_DATABASE_URL=postgresql+psycopg://jobradar:local@127.0.0.1:5433/jobradar_test
